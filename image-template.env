# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
# Freizzite: this is the default (primary) variant for local builds;
# CI overrides IMAGE_NAME/BASE_IMAGE/BUILD_VARIANT per matrix entry
# in .github/workflows/build.yml.
IMAGE_NAME=freizzite-dx-nvidia

# Make this the same as your github username/organisation
REPO_ORGANIZATION="freiheit"

# TODO: make IMAGE_DESC per-variant (mention dx-nvidia / deck in the
# description). Would need an IMAGE_DESC override in the build.yml matrix
# alongside IMAGE_NAME/BASE_IMAGE/BUILD_VARIANT — env beats dotenv, so no
# Justfile change is required.
IMAGE_DESC="Freizzite Customized Bazzite Image"
IMAGE_KEYWORDS="bootc,ublue,universal-blue,bazzite"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/19813?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Freizzite variant parameters (consumed as --build-arg by the Justfile
# build recipe; see Containerfile ARGs). REPO_NAME is the git repo name,
# which differs from the per-variant IMAGE_NAME (used in label URLs).
REPO_NAME=freizzite
BASE_IMAGE=bazzite-dx-nvidia
BASE_TAG=stable
BUILD_VARIANT=bazzite-dx-nvidia
