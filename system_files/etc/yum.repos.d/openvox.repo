[openvox9]
name=OpenVox 9 -- see openvox.md
# OpenVox packaging lags Fedora GA by ~6 weeks. build-common.sh probes this
# release's repo and seds $releasever down one release on a definite 404, so a
# Fedora bump never stalls the build and the current release's packages are
# picked up as soon as they exist. Safe to run one release behind: the AIO RPM
# is self-contained (Autoreq: 0, vendored Ruby/OpenSSL).
baseurl=https://yum.voxpupuli.org/openvox9/fedora/$releasever/$basearch
# enabled=0: the image ships the agent; host dnf and bootc-image-builder
# depsolve have no business here. The build enables it explicitly.
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://yum.voxpupuli.org/GPG-KEY-openvox.pub

[openvox9-f44]
name=OpenVox 9 F44
baseurl=https://yum.voxpupuli.org/openvox9/fedora/44/$basearch
# enabled=0: the image ships the agent; host dnf and bootc-image-builder
# depsolve have no business here. The build enables it explicitly.
enabled=0
gpgcheck=1
repo_gpgcheck=0
gpgkey=https://yum.voxpupuli.org/GPG-KEY-openvox.pub
